<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{t:coming.title} — Stamped</title>
  <meta name="description" content="Stamped — heavyweight, vintage-inspired New York apparel. Launching soon.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; }
    body { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; background: #1c1917; }
    .font-display { font-family: 'Playfair Display', Georgia, serif; }
    .logo-cream { filter: brightness(0) invert(1); }
    ::selection { background: #f7f1e3; color: #1c1917; }
  </style>
</head>
<body class="text-[#f7f1e3]">
  <main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center">
    <!-- Background -->
    <img src="/assets/images/stamped/hero-nyc-bridge.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-stone-950/80 via-stone-950/55 to-stone-950/85"></div>

    <!-- Language picker -->
    <div id="lang-picker" class="absolute right-6 top-6 z-10 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#f7f1e3]/70">
      <button type="button" data-lang="en" class="px-1.5 py-1 hover:text-[#f7f1e3] aria-[current=true]:text-[#f7f1e3] aria-[current=true]:underline aria-[current=true]:underline-offset-4">EN</button>
      <span class="opacity-40" aria-hidden="true">/</span>
      <button type="button" data-lang="de" class="px-1.5 py-1 hover:text-[#f7f1e3] aria-[current=true]:text-[#f7f1e3] aria-[current=true]:underline aria-[current=true]:underline-offset-4">DE</button>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex max-w-xl flex-col items-center">
      <img src="/assets/images/stamped/stamped-logo.png" alt="Stamped" width="180" height="67" class="logo-cream h-14 w-auto" decoding="async">
      <p class="mt-10 text-[11px] font-semibold uppercase tracking-[0.32em] text-[#f7f1e3]/70">{t:coming.eyebrow}</p>
      <h1 class="mt-3 font-display text-6xl leading-none drop-shadow-sm sm:text-7xl md:text-[5.5rem]">{t:coming.title}</h1>
      <p class="mt-5 max-w-md text-[#f7f1e3]/85">{t:coming.copy}</p>

      <form data-stx-notify class="mt-9 flex w-full max-w-md flex-col gap-3 sm:flex-row" action="/api/newsletter/subscribe" method="POST">
        <input
          type="email"
          name="email"
          required
          placeholder="{t:common.email_address}"
          autocomplete="email"
          class="w-full border border-[#f7f1e3]/40 bg-[#f7f1e3]/5 px-4 py-3.5 text-sm text-[#f7f1e3] placeholder:text-[#f7f1e3]/50 backdrop-blur focus:border-[#f7f1e3] focus:outline-none"
        >
        <button type="submit" class="shrink-0 bg-[#f7f1e3] px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-stone-900 transition-colors hover:bg-white">{t:coming.notify}</button>
      </form>
      <p data-stx-notify-thanks class="mt-4 hidden text-sm text-[#f7f1e3]">{t:coming.thanks}</p>

      <div class="mt-14 flex items-center gap-5 text-xs text-[#f7f1e3]/60">
        <span>© 2026 Stamped</span>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[#f7f1e3]" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
          Instagram
        </a>
      </div>
    </div>
  </main>

  <script data-stx-scoped>
  ;(() => {
    if (window.__stampedComingWired) return
    window.__stampedComingWired = true
    document.addEventListener('submit', (e) => {
      const form = e.target instanceof Element ? e.target.closest('[data-stx-notify]') : null
      if (!form) return
      e.preventDefault()
      const thanks = document.querySelector('[data-stx-notify-thanks]')
      form.style.display = 'none'
      if (thanks) thanks.classList.remove('hidden')
    })
  })()
  </script>
</body>
</html>
