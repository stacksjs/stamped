@extends('layouts/storefront')

@section('title', 'Stamped')

<script server>
const path = require('path')
const { findProduct, relatedProducts, priceLabel } = require(path.resolve(process.cwd(), 'resources/functions/catalog.ts'))

const product = (typeof slug !== 'undefined' && slug) ? findProduct(slug) : null

const vm = product
  ? {
      slug: product.slug,
      name: product.name,
      color: product.color,
      category: product.category,
      priceLabel: priceLabel(product.price),
      compareAtLabel: product.compareAt ? priceLabel(product.compareAt) : '',
      image: product.images[0],
      thumbs: product.images,
      sizes: product.sizes,
      blurb: product.blurb,
      description: product.description,
      details: product.details,
      badge: product.badge || '',
    }
  : null

const related = product
  ? relatedProducts(product.slug, 4).map(p => ({
      slug: p.slug,
      name: p.name,
      color: p.color,
      priceLabel: priceLabel(p.price),
      compareAtLabel: p.compareAt ? priceLabel(p.compareAt) : '',
      image: p.images[0],
      hoverImage: p.images[1] || '',
      badge: p.badge || '',
    }))
  : []
</script>

@section('content')
  @if (!vm)
    <div class="mx-auto max-w-2xl px-6 py-28 text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-stone-500">404</p>
      <h1 class="mt-3 font-display text-4xl text-stone-900">We couldn't find that piece</h1>
      <p class="mt-3 text-stone-600">It may have sold out or moved. Browse the rest of the collection.</p>
      <a href="/products" data-stx-link class="mt-8 inline-flex bg-stone-900 px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#f7f1e3] hover:bg-stone-700">Shop all</a>
    </div>
  @else
    <div class="mx-auto max-w-6xl px-6 py-10 md:py-14">

      <!-- Breadcrumb -->
      <nav class="mb-8 text-xs uppercase tracking-[0.14em] text-stone-500">
        <a href="/" data-stx-link class="hover:text-stone-900">Home</a>
        <span class="px-2">/</span>
        <a href="/products" data-stx-link class="hover:text-stone-900">Shop</a>
        <span class="px-2">/</span>
        <span class="text-stone-700">{{ vm.name }}</span>
      </nav>

      <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
        <!-- Gallery (framework Storefront component) -->
        <ProductGallery image="{{ vm.image }}" :thumbs="vm.thumbs" alt="{{ vm.name }}" />

        <!-- Details -->
        <div class="md:sticky md:top-28">
          @if (vm.badge)
            <span class="inline-flex rounded-full bg-stone-900 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#f7f1e3]">{{ vm.badge }}</span>
          @endif
          <h1 class="mt-3 font-display text-4xl leading-tight text-stone-900 md:text-5xl">{{ vm.name }}</h1>
          <p class="mt-1 text-sm uppercase tracking-[0.14em] text-stone-500">{{ vm.color }}</p>

          <div class="mt-4 flex items-center gap-3 text-lg">
            <span class="font-medium text-stone-900">{{ vm.priceLabel }}</span>
            @if (vm.compareAtLabel)
              <span class="text-stone-400 line-through">{{ vm.compareAtLabel }}</span>
            @endif
          </div>

          <p class="mt-5 leading-relaxed text-stone-600">{{ vm.blurb }}</p>

          <!-- Size selector -->
          <div class="mt-8" data-stx-size-group>
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-900">Size</span>
              <a href="#size-guide" class="text-[11px] uppercase tracking-[0.14em] text-stone-500 underline underline-offset-2 hover:text-stone-900">Size guide</a>
            </div>
            <div class="mt-3 flex flex-wrap gap-2.5">
              @foreach (vm.sizes as size, i)
                <button
                  type="button"
                  data-size="{{ size }}"
                  class="h-11 min-w-[3rem] rounded-sm border border-stone-900/20 px-3 text-sm font-medium text-stone-800 transition-colors hover:border-stone-900 data-[active=true]:border-stone-900 data-[active=true]:bg-stone-900 data-[active=true]:text-[#f7f1e3]"
                  {{ i === 1 ? 'data-active=true' : '' }}
                >{{ size }}</button>
              @endforeach
            </div>
          </div>

          <!-- Quantity + add to bag -->
          <div class="mt-8 flex items-stretch gap-3">
            <QuantitySelector :min="1" :max="10" :value="1" />
            <button
              type="button"
              data-stx-add-to-bag
              class="flex-1 bg-stone-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#f7f1e3] transition-colors hover:bg-stone-700"
            >Add to bag — {{ vm.priceLabel }}</button>
          </div>
          <p data-stx-added class="mt-3 hidden text-sm text-emerald-700">Added to your bag ✓ <a href="/cart" data-stx-link class="underline underline-offset-2">View bag</a></p>

          <!-- Accordions -->
          <div class="mt-10 divide-y divide-stone-900/10 border-y border-stone-900/10">
            <details class="group py-4" open>
              <summary class="flex cursor-pointer list-none items-center justify-between text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-900">
                Description
                <span class="text-stone-400 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-stone-600">{{ vm.description }}</p>
            </details>
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-900">
                Details &amp; care
                <span class="text-stone-400 transition-transform group-open:rotate-45">+</span>
              </summary>
              <ul class="mt-3 space-y-2 text-sm text-stone-600">
                @foreach (vm.details as d)
                  <li class="flex gap-2"><span class="text-stone-400">—</span>{{ d }}</li>
                @endforeach
              </ul>
            </details>
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-900">
                Shipping &amp; returns
                <span class="text-stone-400 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-stone-600">Free U.S. shipping over $75, shipped within two business days. 30-day returns on unworn items — see our <a href="/policies/returns" data-stx-link class="underline underline-offset-2">returns policy</a>.</p>
            </details>
          </div>
        </div>
      </div>

      <!-- Related -->
      @if (related.length > 0)
        <section class="mt-24">
          <h2 class="mb-10 text-center font-display text-3xl text-stone-900 md:text-4xl">You might also like</h2>
          <div class="grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
            @foreach (related as r)
              <ProductTile
                slug="{{ r.slug }}"
                name="{{ r.name }}"
                color="{{ r.color }}"
                priceLabel="{{ r.priceLabel }}"
                compareAtLabel="{{ r.compareAtLabel }}"
                image="{{ r.image }}"
                hoverImage="{{ r.hoverImage }}"
                badge="{{ r.badge }}"
              />
            @endforeach
          </div>
        </section>
      @endif
    </div>

    <script data-stx-scoped>
    ;(() => {
      if (window.__stampedPdpWired) return
      window.__stampedPdpWired = true
      document.addEventListener('click', (e) => {
        const t = e.target instanceof Element ? e.target : null
        if (!t) return
        const size = t.closest('[data-size]')
        if (size) {
          const group = size.closest('[data-stx-size-group]')
          group && group.querySelectorAll('[data-size]').forEach(b => b.setAttribute('data-active', String(b === size)))
          return
        }
        if (t.closest('[data-stx-add-to-bag]')) {
          const note = document.querySelector('[data-stx-added]')
          if (note) note.classList.remove('hidden')
          const badge = document.querySelector('[data-stx-cart-count]')
          if (badge) {
            const next = (Number(badge.textContent) || 0) + 1
            badge.textContent = String(next)
            badge.classList.remove('hidden')
          }
        }
      })
    })()
    </script>
  @endif
@endsection
