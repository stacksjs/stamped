@extends('layouts/storefront')

@section('title', 'Collections — Stamped')

<script server>
const path = require('path')
const { getProducts } = require(path.resolve(process.cwd(), 'resources/functions/catalog.ts'))
const loc = (typeof locale !== 'undefined' && locale === 'de') ? 'de' : 'en'
const all = getProducts(loc)

const titleMarker = {
  Tees: '{t:filters.category_tees}',
  Hoodies: '{t:filters.category_hoodies}',
  Crewnecks: '{t:filters.category_crewnecks}',
}
const seen = new Set()
const collections = []
for (const p of all) {
  if (seen.has(p.category)) continue
  seen.add(p.category)
  const count = all.filter(x => x.category === p.category).length
  collections.push({ title: titleMarker[p.category] || p.category, handle: p.category.toLowerCase(), image: p.images[0], count })
}
</script>

@section('content')
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <header class="text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-stone-500">{t:collections.eyebrow}</p>
      <h1 class="mt-3 font-display text-5xl text-stone-900 md:text-6xl">{t:collections.title}</h1>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (collections as c)
        <a href="/collections/{{ c.handle }}" data-stx-link class="group relative block overflow-hidden rounded-sm bg-[#efe7d4]">
          <div class="aspect-[3/4]">
            <img src="{{ c.image }}" alt="{{ c.title }}" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105">
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 text-[#f7f1e3]">
            <h2 class="font-display text-3xl">{{ c.title }}</h2>
            <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.18em] opacity-90">{{ c.count }} {t:common.pieces} · {t:collections.shop_cta} →</p>
          </div>
        </a>
      @endforeach
    </div>
  </div>
@endsection
