  <div class="mx-auto max-w-md px-6 py-20">
    <header class="text-center">
      <h1 class="font-display text-5xl text-stone-900">{t:account.register_title}</h1>
      <p class="mt-3 text-stone-600">{t:account.register_copy}</p>
    </header>

    <form action="/account" method="get" class="mt-10 space-y-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">{t:checkout.first_name}</label>
          <input name="first" required autocomplete="given-name" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
        </div>
        <div>
          <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">{t:checkout.last_name}</label>
          <input name="last" required autocomplete="family-name" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
        </div>
      </div>
      <div>
        <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">{t:contact.email}</label>
        <input type="email" name="email" required autocomplete="email" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
      </div>
      <div>
        <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">{t:account.password}</label>
        <input type="password" name="password" required autocomplete="new-password" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
      </div>
      <label class="flex items-start gap-2.5 text-sm text-stone-600">
        <input type="checkbox" name="news" class="mt-0.5 h-4 w-4 rounded border-stone-400 text-stone-900 focus:ring-stone-900">
        {t:account.register_offers}
      </label>
      <button type="submit" class="w-full bg-stone-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#f7f1e3] transition-colors hover:bg-stone-700">{t:account.register_button}</button>
    </form>

    <p class="mt-8 text-center text-sm text-stone-600">
