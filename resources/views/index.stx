@extends('layouts/storefront')

@section('title', 'Stamped — I ❤ New York')

<script server>
const path = require('path')
const { getProducts, priceLabel, lookbook } = require(path.resolve(process.cwd(), 'resources/functions/catalog.ts'))

const tiles = getProducts().map(p => ({
  slug: p.slug,
  name: p.name,
  color: p.color,
  priceLabel: priceLabel(p.price),
  compareAtLabel: p.compareAt ? priceLabel(p.compareAt) : '',
  image: p.images[0],
  hoverImage: p.images[1] || '',
  badge: p.badge || '',
}))

const featured = getProducts().find(p => p.slug === 'ny-tee')
const featuredPrice = priceLabel(featured.price)
const gallery = lookbook
</script>

