@extends('layouts/storefront')

@section('title', 'Checkout — Contact')

<script server>
const path = require('path')
const { getProducts, priceLabel } = require(path.resolve(process.cwd(), 'resources/functions/catalog.ts'))
const loc = (typeof locale !== 'undefined' && locale === 'de') ? 'de' : 'en'
const all = getProducts(loc)
const sample = [{ slug: 'ny-tee', qty: 1 }, { slug: 'ny-hoodie', qty: 1 }]
const items = sample.map((s) => {
  const p = all.find(x => x.slug === s.slug)
  const lineTotal = p.price * s.qty
  return { name: `${p.name} — ${p.color}`, qty: s.qty, lineTotal, lineTotalLabel: priceLabel(lineTotal) }
})
const subtotal = items.reduce((s, i) => s + i.lineTotal, 0)
const shipping = subtotal >= 85 ? 0 : 6
const total = subtotal + shipping
const subtotalLabel = priceLabel(subtotal)
const shippingLabel = shipping === 0 ? '{t:summary.free}' : priceLabel(shipping)
const totalLabel = priceLabel(total)
const steps = [
  { key: 'contact', label: '{t:checkout.step_contact}', href: '/checkout/contact' },
  { key: 'shipping', label: '{t:checkout.step_shipping}', href: '/checkout/shipping' },
  { key: 'payment', label: '{t:checkout.step_payment}', href: '/checkout/payment' },
]
</script>

@section('content')
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16">
    <CheckoutSteps current="contact" :steps="steps" />

    <div class="grid items-start gap-10 md:grid-cols-[1fr_360px]">
      <div>
        <h1 class="font-display text-4xl text-stone-900">{t:checkout.contact_title}</h1>
        <p class="mt-2 text-stone-600">{t:checkout.contact_copy}</p>

        <form action="/checkout/shipping" method="get" class="mt-8 space-y-5">
          <div>
            <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">{t:contact.email}</label>
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
          </div>
          <label class="flex items-center gap-2.5 text-sm text-stone-600">
            <input type="checkbox" name="news" class="h-4 w-4 rounded border-stone-400 text-stone-900 focus:ring-stone-900">
            {t:checkout.email_offers}
          </label>
          <div class="flex items-center justify-between gap-4 pt-2">
            <a href="/cart" data-stx-link class="text-sm text-stone-500 hover:text-stone-900">← {t:checkout.back_to_bag}</a>
            <button type="submit" class="bg-stone-900 px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#f7f1e3] transition-colors hover:bg-stone-700">{t:checkout.continue_to_shipping}</button>
          </div>
        </form>
      </div>

      <BagSummary
        :items="items"
        subtotalLabel="{{ subtotalLabel }}"
        shippingLabel="{{ shippingLabel }}"
        totalLabel="{{ totalLabel }}"
        :showItems="true"
      />
    </div>
  </div>
@endsection
