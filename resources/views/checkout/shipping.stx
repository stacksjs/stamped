@extends('layouts/storefront')

@section('title', 'Checkout — Shipping')

<script server>
const path = require('path')
const { getProducts, priceLabel } = require(path.resolve(process.cwd(), 'resources/functions/catalog.ts'))
const all = getProducts()
const sample = [{ slug: 'ny-tee', qty: 1 }, { slug: 'ny-hoodie', qty: 1 }]
const items = sample.map((s) => {
  const p = all.find(x => x.slug === s.slug)
  const lineTotal = p.price * s.qty
  return { name: `${p.name} — ${p.color}`, qty: s.qty, lineTotal, lineTotalLabel: priceLabel(lineTotal) }
})
const subtotal = items.reduce((s, i) => s + i.lineTotal, 0)
const shipping = subtotal >= 75 ? 0 : 6
const total = subtotal + shipping
const subtotalLabel = priceLabel(subtotal)
const shippingLabel = shipping === 0 ? 'Free' : priceLabel(shipping)
const totalLabel = priceLabel(total)
</script>

@section('content')
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16">
    <CheckoutSteps current="shipping" />

    <div class="grid items-start gap-10 md:grid-cols-[1fr_360px]">
      <div>
        <h1 class="font-display text-4xl text-stone-900">Shipping address</h1>
        <p class="mt-2 text-stone-600">Where should we send your order?</p>

        <form action="/checkout/payment" method="get" class="mt-8 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">First name</label>
              <input name="first" required class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
            </div>
            <div>
              <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">Last name</label>
              <input name="last" required class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
            </div>
          </div>
          <div>
            <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">Address</label>
            <input name="address" required autocomplete="street-address" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
          </div>
          <div class="grid gap-5 sm:grid-cols-3">
            <div>
              <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">City</label>
              <input name="city" required value="New York" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
            </div>
            <div>
              <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">State</label>
              <input name="state" required value="NY" class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
            </div>
            <div>
              <label class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">ZIP</label>
              <input name="zip" required class="mt-1.5 w-full border border-stone-900/20 bg-transparent px-4 py-3 text-sm focus:border-stone-900 focus:outline-none">
            </div>
          </div>

          <fieldset class="mt-2">
            <legend class="text-[11px] font-semibold uppercase tracking-[0.16em] text-stone-500">Delivery method</legend>
            <div class="mt-3 space-y-3">
              <label class="flex items-center justify-between gap-3 border border-stone-900 px-4 py-3.5 text-sm">
                <span class="flex items-center gap-3"><input type="radio" name="ship" checked class="text-stone-900 focus:ring-stone-900"> Standard · 3–5 business days</span>
                <span class="font-medium">{{ shippingLabel }}</span>
              </label>
              <label class="flex items-center justify-between gap-3 border border-stone-900/20 px-4 py-3.5 text-sm">
                <span class="flex items-center gap-3"><input type="radio" name="ship" class="text-stone-900 focus:ring-stone-900"> Express · 1–2 business days</span>
                <span class="font-medium">$18.00</span>
              </label>
            </div>
          </fieldset>

          <div class="flex items-center justify-between gap-4 pt-2">
            <a href="/checkout/contact" data-stx-link class="text-sm text-stone-500 hover:text-stone-900">← Back to contact</a>
            <button type="submit" class="bg-stone-900 px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#f7f1e3] transition-colors hover:bg-stone-700">Continue to payment</button>
          </div>
        </form>
      </div>

      <OrderSummary
        :items="items"
        subtotalLabel="{{ subtotalLabel }}"
        shippingLabel="{{ shippingLabel }}"
        totalLabel="{{ totalLabel }}"
        :showItems="true"
      />
    </div>
  </div>
@endsection
